# Copy to .env (git-ignored). Never commit real values.
# Supabase: Project Settings > Database > Connection string.
# DATABASE_URL = pooled connection (transaction pooler, port 6543), with ?pgbouncer=true
# DIRECT_URL   = direct connection (port 5432), used by migrations
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres

PORT=3001
NODE_ENV=development

# SIWE: domain and origins must match what the frontend is served from.
SIWE_DOMAIN=localhost:5173
SIWE_ORIGINS=http://localhost:5173
ORBIX_CHAIN_ID=11155111
SESSION_TTL_HOURS=24
NONCE_TTL_MINUTES=5

# Frontend (public, safe to expose)
VITE_WALLETCONNECT_PROJECT_ID=
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_ORBIX_NFT_ADDRESS=0x4c0Da0aACF74d6D58B1F09dBAE77287aCD0089fb
VITE_ORBIX_MARKETPLACE_ADDRESS=0x6ab97D118cEbCfA6eBCE4bF0B8e8306fb05BE017

# Indexer (server only). Use a paid/own RPC for production reliability.
INDEXER_RPC_URL=
INDEXER_START_BLOCK=0
INDEXER_CONFIRMATIONS=12
INDEXER_BATCH_SIZE=500
